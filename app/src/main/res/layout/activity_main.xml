<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J.A.R.V.I.S."
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#00E5FF"
            android:letterSpacing="0.2"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE - VOICE SYSTEM ACTIVE"
            android:textSize="12sp"
            android:textColor="#00FF66"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerInParent="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hud_circle_outer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="🎙️"
            android:textSize="50sp"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="50dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dinleniyor... 'Ahmet ara' diyebilirsiniz."
            android:textColor="#8BE9FD"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="Sistemi Durdur"
            android:textColor="#050B14"
            android:textStyle="bold"
            android:backgroundTint="#00E5FF"
            android:elevation="8dp" />
    </LinearLayout>

</RelativeLayout>
